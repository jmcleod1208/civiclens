# ─────────────────────────────────────────────────────────────────────────────
# CivicLens — environment variable template
# Copy this file to packages/db/.env and fill in every value before running.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local Docker:  postgresql://civiclens:civiclens@localhost:5432/civiclens
# Supabase:      postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=""

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local Docker:  omit REDIS_URL and set HOST/PORT below
# Upstash:       rediss://default:[password]@[host].upstash.io:6379
REDIS_URL=""
# Used only when REDIS_URL is not set (local Docker):
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ── Congress.gov ──────────────────────────────────────────────────────────────
# https://api.congress.gov/sign-up/
CONGRESS_API_KEY=""

# ── OpenStates ────────────────────────────────────────────────────────────────
# https://v3.openstates.org/
OPENSTATES_API_KEY=""

# ── OpenAI (document summarization) ──────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ── Google AI / Gemini (PDF extraction) ───────────────────────────────────────
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=""

# ── Google Civic Information API (deprecated — replaced by Census geocoder) ───
GOOGLE_CIVIC_API_KEY=""

# ── Supabase (auth provider) ──────────────────────────────────────────────────
# https://app.supabase.com → Project Settings → API
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── RevenueCat (subscriptions) ────────────────────────────────────────────────
# https://app.revenuecat.com → Project → API Keys
# Public keys go in apps/mobile/.env as EXPO_PUBLIC_REVENUECAT_*_KEY
REVENUECAT_PUBLIC_KEY=""
REVENUECAT_SECRET_KEY=""

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or "*" for all (dev only)
ALLOWED_ORIGINS="*"
