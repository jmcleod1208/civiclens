{
  "name": "@civiclens/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "type-check": "tsc --noEmit",
    "test:congress": "npx tsx src/test-congress.ts"
  },
  "dependencies": {
    "@civiclens/db": "workspace:*",
    "@civiclens/shared": "workspace:*",
    "bullmq": "^5.53.0",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "bun-types": "latest",
    "dotenv": "^16.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
